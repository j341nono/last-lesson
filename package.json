{
  "name": "last-lesson",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "server": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "types": "wrangler types --strict-vars false",
    "db:migrate": "wrangler d1 migrations apply last-lesson --local",
    "format": "prettier --write src server tests docs *.ts *.json *.jsonc *.md"
  },
  "dependencies": {
    "idb-keyval": "^6.2.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.10",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^5.0.5",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "undici": "^7.30.1"
  }
}

{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "last-lesson",
  "main": "server/index.ts",
  "compatibility_date": "2026-10-25",
  "assets": {"directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application", "run_worker_first": ["/api/*"]},
  "d1_databases": [{"binding": "DB", "database_name": "last-lesson", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations"}],
  "observability": {"enabled": true, "traces": {"enabled": true}},
  "vars": {"LLM_BASE_URL": "", "LLM_MODEL": ""}
}
